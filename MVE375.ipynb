   "source": [
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "# Skapa testdata\n",
    "data = {'Namn': ['Anna', 'Björn', 'Cecilia', 'David'],\n",
    "        'Poäng': [85, 92, 78, 95]}\n",
    "df = pd.DataFrame(data)\n",
    "\n",
    "# Visa tabell och diagram\n",
    "display(df)\n",
    "plt.bar(df['Namn'], df['Poäng'], color='skyblue')\n",
    "plt.show()"
   ]
  }
